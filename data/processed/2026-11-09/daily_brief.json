  "learning_notes": [
    {
      "term": "market structure",
      "zh": "市场结构，指交易、托管、清算、ETF、监管等制度安排。",
      "example": "Crypto market structure rules can affect institutional participation."
    },
    {
      "term": "inflation expectations",
      "zh": "通胀预期，指家庭、企业或市场对未来通胀的预估。",
      "example": "Inflation expectations can shape wage bargaining and bond yields."
    },
    {
      "term": "real yield",
      "zh": "实际收益率，名义利率扣除通胀预期后的收益率。",
      "example": "Gold often reacts more to real yields than nominal yields."
    },
    {
      "term": "terminal rate",
      "zh": "终端利率，市场预期本轮加息周期的最高政策利率。",
      "example": "A higher terminal rate can pressure growth stocks."
    },
    {
      "term": "soft landing",
      "zh": "软着陆，指通胀回落而经济避免明显衰退。",
      "example": "Markets often rally when data support a soft landing."
    },
    {
      "term": "risk-off",
      "zh": "避险模式，资金偏向美元、国债、黄金等防御资产。",
      "example": "A geopolitical shock can push markets into risk-off mode."
    }
