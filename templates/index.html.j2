<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FinTech Macro Radar - {{ metadata.latest_date }}</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #f8fafd;
      --surface: #ffffff;
      --surface-soft: #f1f5ff;
      --text: #202124;
      --muted: #5f6368;
      --line: #dfe6f3;
      --blue: #1a73e8;
      --blue-soft: #e8f0fe;
      --green: #188038;
      --green-soft: #e6f4ea;
      --yellow: #f9ab00;
      --yellow-soft: #fef7e0;
      --red: #d93025;
      --red-soft: #fce8e6;
      --purple: #9334e6;
      --purple-soft: #f3e8fd;
      --shadow: 0 18px 55px rgba(60, 64, 67, 0.10);
      --shadow-soft: 0 8px 28px rgba(60, 64, 67, 0.08);
      --radius-xl: 30px;
      --radius-lg: 22px;
      --radius-md: 16px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(66, 133, 244, 0.15), transparent 32rem),
        radial-gradient(circle at 88% 8%, rgba(52, 168, 83, 0.12), transparent 26rem),
        radial-gradient(circle at 76% 42%, rgba(251, 188, 4, 0.12), transparent 23rem),
        linear-gradient(180deg, #ffffff 0%, var(--bg) 34rem);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Google Sans", "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      line-height: 1.72;
    }
    a { color: var(--blue); text-decoration: none; font-weight: 650; }
    a:hover { text-decoration: underline; }
    .app-shell { width: min(1440px, calc(100vw - 32px)); margin: 0 auto; padding: 22px 0 56px; }
    .topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 13px 16px;
      margin-bottom: 20px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(223, 230, 243, 0.8);
      border-radius: 999px;
      backdrop-filter: blur(18px);
      box-shadow: 0 8px 24px rgba(60, 64, 67, 0.08);
    }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 250px; }
    .brand-mark {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 15px;
      color: white;
      font-weight: 950;
      background: conic-gradient(from 140deg, #4285f4, #34a853, #fbbc04, #ea4335, #4285f4);
      box-shadow: 0 8px 20px rgba(26, 115, 232, 0.28);
    }
    .brand-title { font-size: 15px; font-weight: 850; letter-spacing: 0; }
    .brand-subtitle { margin-top: -2px; color: var(--muted); font-size: 12px; }
    .top-actions { display: flex; align-items: center; gap: 10px; flex: 1; justify-content: flex-end; }
    .search-box { position: relative; flex: 1; max-width: 460px; }
    .search-box input {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 12px 44px;
      background: #f8fafd;
      color: var(--text);
      outline: none;
      font-size: 14px;
      transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
    }
    .search-box input:focus { border-color: rgba(26, 115, 232, .55); background: white; box-shadow: 0 0 0 4px rgba(26, 115, 232, .12); }
    .search-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 16px; }
    .pill-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--line);
      background: white;
      color: var(--text);
      border-radius: 999px;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 760;
      white-space: nowrap;
      box-shadow: 0 2px 10px rgba(60,64,67,.05);
    }
    .hero {
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(223, 230, 243, 0.9);
      border-radius: var(--radius-xl);
      background:
        linear-gradient(135deg, rgba(232,240,254,.92), rgba(255,255,255,.96) 46%, rgba(230,244,234,.82)),
        white;
      box-shadow: var(--shadow);
      padding: clamp(28px, 4.8vw, 58px);
      margin-bottom: 22px;
      min-height: min(620px, calc(100vh - 132px));
      display: grid;
      align-content: center;
    }
    .hero::after {
      content: "";
      position: absolute;
      right: -120px;
      top: -120px;
      width: 340px;
      height: 340px;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(251,188,4,.32), rgba(251,188,4,0) 66%);
    }
    .hero::before {
      content: "";
      position: absolute;
      left: 58%;
      bottom: -160px;
      width: 420px;
      height: 420px;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(147,52,230,.18), rgba(147,52,230,0) 67%);
    }
    .hero-inner { position: relative; z-index: 1; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .76);
      border: 1px solid rgba(223, 230, 243, .9);
      color: var(--blue);
      font-size: 13px;
      font-weight: 850;
      margin-bottom: 18px;
    }
    h1 {
      margin: 0 0 12px;
      font-size: clamp(44px, 8.6vw, 96px);
      line-height: 0.96;
      letter-spacing: 0;
      max-width: 1060px;
    }
    .hero-copy { margin: 0; max-width: 880px; color: var(--muted); font-size: clamp(17px, 2vw, 22px); }
    .hero-copy strong { color: var(--text); }
    .status-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 26px; }
    .metric-card {
      min-height: 108px;
      padding: 17px;
      border-radius: 22px;
      background: rgba(255, 255, 255, .82);
      border: 1px solid rgba(223, 230, 243, .92);
      box-shadow: 0 10px 24px rgba(60, 64, 67, .06);
    }
    .metric-card.red { background: linear-gradient(135deg, white, var(--red-soft)); }
    .metric-card.blue { background: linear-gradient(135deg, white, var(--blue-soft)); }
    .metric-card.green { background: linear-gradient(135deg, white, var(--green-soft)); }
    .metric-card.yellow { background: linear-gradient(135deg, white, var(--yellow-soft)); }
    .metric-label { display: block; color: var(--muted); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
    .metric-value { display: block; margin-top: 7px; color: var(--text); font-size: 22px; font-weight: 900; line-height: 1.25; word-break: break-word; }
    .layout { display: grid; grid-template-columns: 286px minmax(0, 1fr); gap: 22px; align-items: start; }
    .side-panel {
      position: sticky;
      top: 92px;
      max-height: calc(100vh - 112px);
      overflow: auto;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: rgba(255, 255, 255, .84);
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow-soft);
    }
    .side-panel h2 { margin: 0 0 12px; font-size: 14px; letter-spacing: .02em; color: var(--muted); text-transform: uppercase; }
    .filter-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .filter-chip {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 11px;
      background: #fff;
      color: var(--muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 850;
    }
    .filter-chip.active { color: var(--blue); background: var(--blue-soft); border-color: rgba(26,115,232,.26); }
    .toc, .archive { display: grid; gap: 7px; }
    .toc a, .archive a { display: block; color: #3c4043; border-radius: 12px; padding: 8px 10px; font-size: 13px; font-weight: 680; }
    .toc a:hover, .archive a:hover { background: var(--surface-soft); text-decoration: none; }
    .archive a:first-child { background: var(--blue-soft); color: var(--blue); }
    .content-panel { display: grid; gap: 18px; }
    .section-block {
      padding: clamp(18px, 3vw, 28px);
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      background: rgba(255,255,255,.88);
      box-shadow: var(--shadow-soft);
    }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
    h2, h3, h4 { scroll-margin-top: 110px; }
    h2 { margin: 0; font-size: clamp(25px, 3vw, 36px); line-height: 1.14; letter-spacing: 0; }
    h3 { margin: 20px 0 12px; color: #174ea6; font-size: 21px; letter-spacing: 0; }
    .section-note { color: var(--muted); font-size: 13px; font-weight: 680; }
    .themes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; list-style: none; margin: 0; padding: 0; }
    .themes li {
      min-height: 92px;
      padding: 15px;
      border-radius: 20px;
      border: 1px solid var(--line);
      background: linear-gradient(135deg, #ffffff, #f7faff);
      color: #3c4043;
      font-weight: 720;
      overflow-wrap: anywhere;
    }
    .themes li:nth-child(2) { background: linear-gradient(135deg, #fff, var(--green-soft)); }
    .themes li:nth-child(3) { background: linear-gradient(135deg, #fff, var(--yellow-soft)); }
    .asset-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .asset-card {
      min-height: 96px;
      padding: 16px;
      border-radius: 22px;
      background: white;
      border: 1px solid var(--line);
      box-shadow: 0 8px 22px rgba(60,64,67,.05);
    }
    .asset-label { color: var(--muted); font-size: 13px; font-weight: 760; }
    .asset-value { margin-top: 8px; font-size: 24px; font-weight: 950; }
    .up .asset-value, .up .move { color: var(--green); }
    .down .asset-value, .down .move { color: var(--red); }
    .flat .asset-value, .flat .move { color: var(--muted); }
    .movers { display: grid; gap: 9px; }
    .mover {
      display: grid;
      grid-template-columns: minmax(118px, 0.34fr) minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 12px;
      background: #fff;
      min-width: 0;
    }
    .ticker { font-weight: 920; overflow-wrap: anywhere; }
    .mover-meta { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
    .move { font-weight: 920; white-space: nowrap; }
    .news-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .radar-card {
      position: relative;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 26px;
      background: white;
      box-shadow: var(--shadow-soft);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      min-width: 0;
    }
    .radar-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: rgba(26, 115, 232, .28); }
    .card-head { display: flex; align-items: start; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
    .tier-badge {
      flex: none;
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 7px 10px;
      font-size: 11px;
      letter-spacing: .04em;
      font-weight: 900;
      text-transform: uppercase;
      background: var(--red-soft);
      color: var(--red);
    }
    .radar-card h3 { margin: 0; color: var(--text); font-size: 19px; line-height: 1.35; }
    .radar-card p { margin: 10px 0 0; color: #3c4043; }
    .badge-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 13px; }
    .badge { border: 1px solid var(--line); border-radius: 999px; padding: 4px 9px; color: var(--muted); font-size: 12px; background: #f8fafd; }
    .policy-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
    .policy-list li {
      border-left: 5px solid var(--yellow);
      border-radius: 0 18px 18px 0;
      padding: 12px 14px;
      background: var(--yellow-soft);
      color: #3c4043;
    }
    .chart-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .chart-card { margin: 0; padding: 12px; border: 1px solid var(--line); border-radius: 22px; background: white; box-shadow: var(--shadow-soft); }
    .chart-card img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 16px; background: #fff; }
    .chart-label { margin-top: 8px; color: var(--muted); font-size: 13px; }
    .report-shell {
      padding: clamp(18px, 3vw, 28px);
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      background: rgba(255,255,255,.88);
      box-shadow: var(--shadow-soft);
    }
    .report-shell h1 { font-size: clamp(30px, 4vw, 46px); line-height: 1.1; }
    .report-shell h2 { border-top: 1px solid var(--line); padding-top: 24px; margin-top: 32px; font-size: 28px; }
    .report-shell table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 0.92rem; display: block; overflow-x: auto; }
    .report-shell th, .report-shell td { border-bottom: 1px solid var(--line); padding: 10px 12px; white-space: nowrap; }
    .report-shell th { background: var(--blue-soft); color: #174ea6; }
    .report-shell img { max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 16px; background: #fff; }
    .report-shell blockquote { margin: 16px 0; padding: 14px 18px; border-left: 5px solid var(--blue); border-radius: 0 18px 18px 0; background: var(--blue-soft); color: #174ea6; }
    .hidden { display: none !important; }
    .empty-state, .empty { padding: 24px; border-radius: 24px; border: 1px dashed #cbd5e1; background: rgba(255,255,255,.8); color: var(--muted); }
    .footer-note { color: var(--muted); font-size: 13px; text-align: center; margin: 28px 0 0; }
    @media (max-width: 1080px) {
      .layout { grid-template-columns: 1fr; }
      .side-panel { position: relative; top: 0; max-height: none; }
      .status-grid, .themes, .asset-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 720px) {
      .app-shell { width: min(100% - 20px, 1440px); padding-top: 10px; }
      .topbar { align-items: stretch; border-radius: 24px; flex-direction: column; }
      .brand { min-width: 0; }
      .top-actions { width: 100%; flex-direction: column; }
      .search-box, .pill-link { width: 100%; max-width: none; }
      .hero { min-height: auto; padding: 28px 18px; }
      .status-grid, .themes, .asset-grid, .news-grid, .chart-grid { grid-template-columns: 1fr; }
      .mover { grid-template-columns: minmax(92px, 0.4fr) minmax(0, 1fr) auto; }
      .card-head { flex-direction: column-reverse; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <nav class="topbar" aria-label="Page navigation">
      <div class="brand">
        <div class="brand-mark">F</div>
        <div>
          <div class="brand-title">FinTech Macro Radar</div>
          <div class="brand-subtitle">Global macro morning intelligence</div>
        </div>
      </div>
      <div class="top-actions">
        <label class="search-box">
          <span class="search-icon">⌕</span>
          <input id="radar-search" type="search" placeholder="搜索资产、新闻、政策、关键词">
        </label>
        <a class="pill-link" href="{{ metadata.latest_report_href }}">Latest HTML</a>
        <a class="pill-link" href="https://github.com/georgeorange-crypto/FinTech">GitHub</a>
      </div>
    </nav>

    {% if entries %}
      <header class="hero" id="hero">
        <div class="hero-inner">
          <div class="eyebrow">Macro intelligence dashboard · {{ metadata.latest_date }}</div>
          <h1>FinTech<br>Macro Radar</h1>
          <p class="hero-copy">
            把宏观新闻、政策线索和跨资产行情压缩成一个 <strong>彩色可筛选雷达</strong>：
            先看市场状态，再看 Must Read，最后按资产和主题追踪。
          </p>
          <div class="status-grid">
            <div class="metric-card blue">
              <span class="metric-label">Market Regime</span>
              <span class="metric-value">{{ metadata.regime }}</span>
            </div>
            <div class="metric-card red">
              <span class="metric-label">Must Read</span>
              <span class="metric-value">{{ metadata.news_counts.must_read }}</span>
            </div>
            <div class="metric-card yellow">
              <span class="metric-label">Policy Watch</span>
              <span class="metric-value">{{ metadata.news_counts.policy_watch }}</span>
            </div>
            <div class="metric-card green">
              <span class="metric-label">Market Data</span>
              <span class="metric-value">{{ metadata.market_data_date }}</span>
            </div>
          </div>
        </div>
      </header>

      <div class="layout">
        <aside class="side-panel">
          <h2>Reading filters</h2>
          <div class="filter-chips">
            <button class="filter-chip active" type="button" data-filter="all">All</button>
            <button class="filter-chip" type="button" data-filter="must">Must Read</button>
            <button class="filter-chip" type="button" data-filter="policy">Policy</button>
            <button class="filter-chip" type="button" data-filter="asset">Assets</button>
            <button class="filter-chip" type="button" data-filter="chart">Charts</button>
          </div>
          <h2>Sections</h2>
          <nav class="toc">
            <a href="#themes">今日主线</a>
            <a href="#assets">核心资产</a>
            <a href="#movers">异动雷达</a>
            <a href="#must-read">Must Read</a>
            <a href="#policy">Policy Watch</a>
            <a href="#charts">图表面板</a>
            <a href="#full-report">完整报告</a>
          </nav>
          <h2 style="margin-top:18px;">Archive</h2>
          <nav class="archive">
            {% for entry in entries %}
              <a href="{{ entry.href }}">{{ entry.date }}</a>
            {% endfor %}
          </nav>
        </aside>

        <main class="content-panel">
          <section class="section-block radar-item" id="themes" data-filter="all" data-search="{{ metadata.top_themes | join(' ') }}">
            <div class="section-head">
              <h2>今日主线</h2>
              <span class="section-note">Top themes</span>
            </div>
            <ol class="themes">
              {% for theme in metadata.top_themes[:3] %}
                <li>{{ theme }}</li>
              {% endfor %}
            </ol>
          </section>

          <section class="section-block radar-item" id="assets" data-filter="asset" data-search="{% for card in metadata.cards %}{{ card.label }} {{ card.value }} {% endfor %}">
            <div class="section-head">
              <h2>核心资产</h2>
              <span class="section-note">1D snapshot · {{ metadata.market_data_date }}</span>
            </div>
            <div class="asset-grid">
              {% for card in metadata.cards %}
                <article class="asset-card {{ 'up' if not card.value.startswith('-') and card.value != 'n/a' else 'down' if card.value.startswith('-') else 'flat' }}">
                  <div class="asset-label">{{ card.label }}</div>
                  <div class="asset-value">{{ card.value }}</div>
                </article>
              {% endfor %}
            </div>
          </section>

          <section class="section-block radar-item" id="movers" data-filter="asset" data-search="{% for mover in metadata.asset_movers %}{{ mover.symbol }} {{ mover.group }} {{ mover.trend }} {% endfor %}">
            <div class="section-head">
              <h2>异动雷达</h2>
              <span class="section-note">按 1D 绝对波动排序 · {{ metadata.market_data_date }}</span>
            </div>
            <div class="movers">
              {% for mover in metadata.asset_movers[:8] %}
                <article class="mover {{ mover.direction }}">
                  <div class="ticker">{{ mover.symbol }}</div>
                  <div class="mover-meta">{{ mover.group }} · {{ mover.trend }} · {{ mover.price }}</div>
                  <div class="move">{{ mover.one_day }}</div>
                </article>
              {% endfor %}
            </div>
          </section>

          <section class="section-block radar-item" id="must-read" data-filter="must" data-search="{% for item in metadata.focus_news %}{{ item.title }} {{ item.source }} {{ item.event_type }} {{ item.reason }} {% endfor %}">
            <div class="section-head">
              <h2>Must Read</h2>
              <span class="section-note">优先阅读</span>
            </div>
            <div class="news-grid">
              {% for item in metadata.focus_news %}
                <article class="radar-card">
                  <div class="card-head">
                    <div>
                      <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      <p>{{ item.reason }}</p>
                    </div>
                    <span class="tier-badge">Tier {{ item.importance_tier }}</span>
                  </div>
                  <div class="badge-row">
                    <span class="badge">{{ item.source }}</span>
                    <span class="badge">{{ item.event_type }}</span>
                    <span class="badge">{{ item.impact_strength }}</span>
                    {% for asset in item.assets %}
                      <span class="badge">{{ asset }}</span>
                    {% endfor %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </section>

          <section class="section-block radar-item" id="policy" data-filter="policy" data-search="{% for item in metadata.policy_news %}{{ item.title }} {{ item.market_impact }} {% endfor %}{% for point in metadata.watch_points %}{{ point }} {% endfor %}">
            <div class="section-head">
              <h2>Policy Watch</h2>
              <span class="section-note">政策与风险观察</span>
            </div>
            <ul class="policy-list">
              {% for item in metadata.policy_news %}
                <li><a href="{{ item.url }}">{{ item.title }}</a><br>{{ item.market_impact }}</li>
              {% endfor %}
              {% for point in metadata.watch_points[:3] %}
                <li>{{ point }}</li>
              {% endfor %}
            </ul>
          </section>

          {% if metadata.chart_tiles %}
            <section class="section-block radar-item" id="charts" data-filter="chart" data-search="{% for chart in metadata.chart_tiles %}{{ chart.label }} {% endfor %}">
              <div class="section-head">
                <h2>图表面板</h2>
                <span class="section-note">Summary charts · {{ metadata.chart_date }}</span>
              </div>
              <div class="chart-grid">
                {% for chart in metadata.chart_tiles %}
                  <figure class="chart-card">
                    <img src="{{ chart.src }}" alt="{{ chart.label }} summary chart">
                    <figcaption class="chart-label">{{ chart.label }}</figcaption>
                  </figure>
                {% endfor %}
              </div>
            </section>
          {% endif %}

          <article class="report-shell radar-item" id="full-report" data-filter="all" data-search="full report macro morning brief">
            {{ latest_report_body | safe }}
          </article>
          <p class="footer-note">Generated by Global Macro Morning Brief. Designed for fast triage, not investment advice.</p>
        </main>
      </div>
    {% else %}
      <div class="empty">No reports yet. Run <code>python -m src.main</code> to generate one.</div>
    {% endif %}
  </div>
  <script>
    (function () {
      const input = document.getElementById("radar-search");
      const chips = Array.from(document.querySelectorAll(".filter-chip"));
      const items = Array.from(document.querySelectorAll(".radar-item"));
      let active = "all";

      function normalize(text) {
        return String(text || "").toLowerCase().replace(/\s+/g, " ").trim();
      }

      function applyFilters() {
        const query = normalize(input ? input.value : "");
        items.forEach(function (item) {
          const filter = item.dataset.filter || "all";
          const text = normalize((item.dataset.search || "") + " " + item.textContent);
          const filterOk = active === "all" || filter === active || filter === "all";
          const queryOk = !query || text.includes(query);
          item.classList.toggle("hidden", !(filterOk && queryOk));
        });
      }

      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          chips.forEach(function (item) { item.classList.remove("active"); });
          chip.classList.add("active");
          active = chip.dataset.filter || "all";
          applyFilters();
        });
      });
      if (input) input.addEventListener("input", applyFilters);
    })();
  </script>
</body>
</html>
