<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Global Macro Morning Brief</title>
  <style>
    :root { color-scheme: light dark; --bg: #f6f8fa; --fg: #17202a; --muted: #5b6773; --panel: #fff; --line: #d5dde5; --accent: #0f766e; --soft: #eef7f5; }
    @media (prefers-color-scheme: dark) { :root { --bg: #101214; --fg: #edf2f7; --muted: #a7b0ba; --panel: #181c20; --line: #303840; --accent: #5eead4; --soft: #14221f; } }
    body { margin: 0; background: var(--bg); color: var(--fg); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .layout { display: grid; grid-template-columns: 270px 1fr; min-height: 100vh; }
    aside { border-right: 1px solid var(--line); background: var(--panel); padding: 24px 18px; position: sticky; top: 0; height: 100vh; overflow: auto; }
    main { padding: 24px; overflow-x: hidden; }
    h1 { font-size: 1.2rem; margin: 0 0 18px; }
    h2 { font-size: 1.05rem; margin: 0 0 12px; }
    a { color: var(--accent); text-decoration: none; }
    .links { display: grid; gap: 8px; }
    .links a { padding: 8px 10px; border: 1px solid var(--line); background: var(--bg); border-radius: 6px; }
    .dashboard { display: grid; gap: 16px; margin-bottom: 18px; }
    .summary { border: 1px solid var(--line); background: var(--panel); padding: 18px; border-radius: 8px; }
    .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 8px; }
    .regime { color: var(--accent); font-weight: 700; }
    .cards { display: grid; grid-template-columns: repeat(7, minmax(110px, 1fr)); gap: 10px; }
    .card { border: 1px solid var(--line); background: var(--panel); padding: 12px; border-radius: 8px; }
    .card .label { color: var(--muted); font-size: 0.84rem; }
    .card .value { font-size: 1.15rem; font-weight: 700; margin-top: 4px; }
    .themes { border: 1px solid var(--line); background: var(--soft); padding: 14px 18px; border-radius: 8px; }
    .themes ol { margin: 8px 0 0 20px; padding: 0; }
    iframe { width: 100%; min-height: calc(100vh - 280px); border: 1px solid var(--line); background: var(--panel); border-radius: 8px; }
    .empty { color: var(--muted); padding: 32px; }
    @media (max-width: 1100px) { .cards { grid-template-columns: repeat(3, minmax(120px, 1fr)); } }
    @media (max-width: 800px) { .layout { grid-template-columns: 1fr; } aside { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--line); } main { padding: 16px; } .cards { grid-template-columns: repeat(2, minmax(120px, 1fr)); } }
  </style>
</head>
<body>
  <div class="layout">
    <aside>
      <h1>Morning Briefs</h1>
      <nav class="links">
        {% for entry in entries %}
          <a href="{{ entry.href }}" target="brief-frame">{{ entry.date }}</a>
        {% endfor %}
      </nav>
    </aside>
    <main>
      {% if entries %}
        <section class="dashboard">
          <div class="summary">
            <div class="meta">Latest: {{ metadata.latest_date }}</div>
            <h2>市场状态：<span class="regime">{{ metadata.regime }}</span></h2>
            <div>{{ metadata.regime_summary }}</div>
          </div>
          <div class="cards">
            <div class="card"><div class="label">最新日期</div><div class="value">{{ metadata.latest_date }}</div></div>
            {% for card in metadata.cards %}
              <div class="card"><div class="label">{{ card.label }} 1D</div><div class="value">{{ card.value }}</div></div>
            {% endfor %}
          </div>
          <div class="themes">
            <h2>今日三大主线</h2>
            <ol>
              {% for theme in metadata.top_themes[:3] %}
                <li>{{ theme }}</li>
              {% endfor %}
            </ol>
          </div>
        </section>
        <iframe name="brief-frame" src="{{ entries[0].href }}" title="Latest brief"></iframe>
      {% else %}
        <div class="empty">No reports yet. Run <code>python -m src.main</code> to generate one.</div>
      {% endif %}
    </main>
  </div>
</body>
</html>
